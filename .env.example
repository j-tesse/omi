# Copy to .env and adjust. .env is git-ignored.

# --- Speech-to-text service (services/stt) ---
# Engine: parakeet (fast, ~0.1 core/stream) | whisper (faster-whisper, ~1 core/stream)
STT_ENGINE=parakeet
# Model name; empty = engine default
#   parakeet -> nemo-parakeet-tdt-0.6b-v3
#   whisper  -> large-v3-turbo
STT_MODEL=
# CPU threads for inference (also the container's CPU limit)
STT_THREADS=4
# Weight quantization: int8 | none (fp32)
STT_QUANT=int8
# Force a language (whisper only, e.g. en, de); empty = auto-detect
STT_LANGUAGE=
# Host port (bound to 127.0.0.1) for testing; other containers use http://stt:8000
STT_PORT=8100

# Optional tuning (defaults shown)
# STT_VAD_THRESHOLD=0.5            # speech probability threshold (higher = stricter in noise)
# STT_MAX_WINDOW_S=20              # longest clip given to the engine at once
# STT_STREAM_HANGOVER_S=0.7        # silence that ends an utterance in live streaming
# STT_STREAM_MAX_UTTERANCE_S=15    # force a cut after this much continuous audio
# STT_STREAM_CHECK_EVERY_S=0.5     # how often the stream buffer is checked

# --- LLM alias proxy (services/llm-proxy) ---
# OpenAI-compatible base URL of the real model server (vLLM on the host)
LLM_UPSTREAM_URL=http://host.docker.internal:8000/v1
# API key for the upstream; empty = none (vLLM runs without --api-key)
LLM_UPSTREAM_API_KEY=
# Comma-separated alias=target model names; the request's "model" is replaced.
# Unlisted names pass through unchanged; add "*=<target>" to catch all.
LLM_MODEL_ALIASES=gpt-6-luna=RedHatAI/gemma-4-31B-it-NVFP4,gpt-5-nano=RedHatAI/gemma-4-31B-it-NVFP4,text-embedding-3-large=BAAI/bge-m3
# Where /v1/embeddings goes (the embed service); empty = LLM_UPSTREAM_URL
LLM_EMBEDDINGS_URL=http://embed:8000/v1
# Host port (bound to 127.0.0.1) for testing; other containers use http://llm-proxy:8000/v1
LLM_PROXY_PORT=8101
# Optional (defaults shown)
# LLM_PROXY_TIMEOUT_S=600          # per-request read timeout (long generations)
# LLM_PROXY_LOG_LEVEL=INFO         # DEBUG logs every model rewrite

# --- Embedding service (services/embed) ---
# sentence-transformers model from Hugging Face. Changing it changes the vectors
# (and possibly their size): re-index any vector store afterwards.
EMBED_MODEL=BAAI/bge-m3
# CPU threads for inference (also the container's CPU limit)
EMBED_THREADS=4
# Host port (bound to 127.0.0.1) for testing; llm-proxy uses http://embed:8000/v1
EMBED_PORT=8102
# Optional (defaults shown)
# EMBED_BATCH_SIZE=16              # texts per forward pass
# EMBED_MAX_TOKENS=8192            # longer inputs are truncated (model tokens)
# EMBED_LOG_LEVEL=INFO

# --- Firebase emulators (services/firebase) ---
# Local project id; must start with "demo-" (no real project, no credentials)
FIREBASE_PROJECT_ID=demo-omi-local
# JVM options for the Firestore emulator (heap cap)
FIREBASE_JAVA_OPTS=-Xmx1g
# Ports are fixed (127.0.0.1): Firestore 8103, Auth 8104, UI 8105, UI websocket 8106.
# Data persists in state/firebase/ (written on clean stop only).
#
# Backend wiring (pending; values match upstream's dev harness):
# FIRESTORE_EMULATOR_HOST=firebase:8103
# FIREBASE_AUTH_EMULATOR_HOST=firebase:8104
# FIREBASE_AUTH_PROJECT_ID=demo-omi-local
# FIRESTORE_DATABASE_ID=(default)
# FIREBASE_API_KEY=local-firebase-auth-emulator-api-key
