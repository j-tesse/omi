# Copy to .env and adjust. .env is git-ignored.

# --- Speech-to-text service (services/stt) ---
# Engine: parakeet (fast, ~0.1 core/stream) | whisper (faster-whisper, ~1 core/stream)
STT_ENGINE=parakeet
# Model name; empty = engine default
#   parakeet -> nemo-parakeet-tdt-0.6b-v3
#   whisper  -> large-v3-turbo
STT_MODEL=
# CPU threads for inference (also the container's CPU limit)
STT_THREADS=4
# Weight quantization: int8 | none (fp32)
STT_QUANT=int8
# Force a language (whisper only, e.g. en, de); empty = auto-detect
STT_LANGUAGE=
# Host port (bound to 127.0.0.1) for testing; other containers use http://stt:8000
STT_PORT=8100

# Optional tuning (defaults shown)
# STT_VAD_THRESHOLD=0.5            # speech probability threshold (higher = stricter in noise)
# STT_MAX_WINDOW_S=20              # longest clip given to the engine at once
# STT_STREAM_HANGOVER_S=0.7        # silence that ends an utterance in live streaming
# STT_STREAM_MAX_UTTERANCE_S=15    # force a cut after this much continuous audio
# STT_STREAM_CHECK_EVERY_S=0.5     # how often the stream buffer is checked

# --- LLM alias proxy (services/llm-proxy) ---
# OpenAI-compatible base URL of the real model server (vLLM on the host)
LLM_UPSTREAM_URL=http://host.docker.internal:8000/v1
# API key for the upstream; empty = none (vLLM runs without --api-key)
LLM_UPSTREAM_API_KEY=
# Comma-separated alias=target model names; the request's "model" is replaced.
# Unlisted names pass through unchanged; add "*=<target>" to catch all.
LLM_MODEL_ALIASES=gpt-6-luna=RedHatAI/gemma-4-31B-it-NVFP4,gpt-5-nano=RedHatAI/gemma-4-31B-it-NVFP4,text-embedding-3-large=BAAI/bge-m3
# Where /v1/embeddings goes (the embed service); empty = LLM_UPSTREAM_URL
LLM_EMBEDDINGS_URL=http://embed:8000/v1
# Host port (bound to 127.0.0.1) for testing; other containers use http://llm-proxy:8000/v1
LLM_PROXY_PORT=8101
# Optional (defaults shown)
# LLM_PROXY_TIMEOUT_S=600          # per-request read timeout (long generations)
# LLM_PROXY_LOG_LEVEL=INFO         # DEBUG logs every model rewrite

# --- Embedding service (services/embed) ---
# sentence-transformers model from Hugging Face. Changing it changes the vectors
# (and possibly their size): re-index any vector store afterwards.
EMBED_MODEL=BAAI/bge-m3
# CPU threads for inference (also the container's CPU limit)
EMBED_THREADS=4
# Host port (bound to 127.0.0.1) for testing; llm-proxy uses http://embed:8000/v1
EMBED_PORT=8102
# Optional (defaults shown)
# EMBED_BATCH_SIZE=16              # texts per forward pass
# EMBED_MAX_TOKENS=8192            # longer inputs are truncated (model tokens)
# EMBED_LOG_LEVEL=INFO

# --- Firebase emulators (services/firebase) ---
# Local project id; must start with "demo-" (no real project, no credentials)
FIREBASE_PROJECT_ID=demo-omi-local
# JVM options for the Firestore emulator (heap cap)
FIREBASE_JAVA_OPTS=-Xmx1g
# Ports are fixed (127.0.0.1): Firestore 8103, Auth 8104, UI 8105, UI websocket 8106.
# Data persists in state/firebase/ (written on clean stop only).
#
# Backend wiring (done in docker-compose.yml backend env; values match the harness):
# FIRESTORE_EMULATOR_HOST=firebase:8103
# FIREBASE_AUTH_EMULATOR_HOST=firebase:8104
# FIREBASE_AUTH_PROJECT_ID=demo-omi-local
# FIRESTORE_DATABASE_ID=(default)
# FIREBASE_API_KEY=local-firebase-auth-emulator-api-key

# --- Redis + Typesense (redis, typesense, typesense-init) ---
# Typesense admin API key (any string, local only; the backend needs the same
# value as TYPESENSE_API_KEY). Generate one with: openssl rand -hex 16
TYPESENSE_API_KEY=change-me-local-typesense-key
# Ports are fixed (127.0.0.1): Redis 8107, Typesense 8108. Data persists in
# state/redis/ and state/typesense/ (create both before the first start so they
# are owned by uid 1000, not root).
#
# Backend wiring (done in docker-compose.yml backend env; same keys as the harness):
# REDIS_DB_HOST=redis
# REDIS_DB_PORT=6379
# REDIS_DB_PASSWORD=
# TYPESENSE_HOST=typesense
# TYPESENSE_HOST_PORT=8108
# TYPESENSE_PROTOCOL=http
# TYPESENSE_API_KEY=<same as above>

# --- Omi backend + llm_gateway (backend, llm-gateway, backend-seed) ---
# Everything else (emulators, Redis, Typesense, llm-proxy, stt, storage, rollout
# flags) is fixed in docker-compose.yml (backend environment block).
# Env stage: local (real local services) | offline (fake LLMs, boot smoke test;
# also set OMI_PROVIDER_MODE=offline OMI_LLM_GATEWAY_FEATURE_MODE=off OMI_STT_STUB=1)
OMI_ENV_STAGE=local
# Encrypts conversations, memories and chat in Firestore. >= 32 bytes, keep it
# stable (changing it makes existing data unreadable): openssl rand -hex 32
ENCRYPTION_SECRET=change-me-openssl-rand-hex-32
# Local auth bypass: "Authorization: Bearer <ADMIN_KEY><uid>" acts as <uid>.
# Use a long random value: echo "local-admin-$(openssl rand -hex 12)-"
ADMIN_KEY=change-me-local-admin-key-
# Shared bearer token backend -> llm-gateway: openssl rand -hex 32
OMI_LLM_GATEWAY_SERVICE_TOKEN=change-me-openssl-rand-hex-32
# HMAC key for internal screen-frame approval tokens: openssl rand -hex 32
SCREEN_FRAME_SIGNING_SECRET=change-me-openssl-rand-hex-32
# Host ports (127.0.0.1); in-network: http://backend:8080, http://llm-gateway:8080
BACKEND_PORT=8109
LLM_GATEWAY_PORT=8110
# Optional overrides (defaults shown)
# OMI_PROVIDER_MODE=real
# OMI_LLM_GATEWAY_FEATURE_MODE=gateway
# OMI_STT_STUB=
# OMI_OPENAI_API_KEY=sk-local-llm-proxy-not-real   # dummy; llm-proxy ignores it
# Links the backend hands out for local storage; must resolve inside the stack
# (the backend downloads them itself for batch STT) and, for a phone, outside too.
# OMI_LOCAL_STORAGE_BASE_URL=http://backend:8080/_local/storage
# HOSTED_PUSHER_API_URL=                            # set once the pusher service exists
# SYNC_LEGACY_FRESH_ENABLED=true                    # inline processing of recent offline syncs
# SYNC_LEGACY_FRESH_PERCENT=100
# STT_PRERECORDED_LANGUAGE_GUARD_ENABLED=false      # true routes unknown-language audio to Modulate
# OMI_LLM_GATEWAY_FIRST_BYTE_TIMEOUT_SECONDS=120          # backend -> gateway deadline (upstream 15)

# --- Mobile access (phone app -> this server; docs/mobile-access.md) ---
# Private address the phone uses for BOTH the backend API and the Firebase Auth
# emulator (one nginx vhost, deploy/nginx/omi.conf.template). Must be an
# RFC 1918 / Tailscale (100.64.0.0/10) IP literal or a *.ts.net name: the
# app's local_dev profile refuses anything else at startup.
OMI_PUBLIC_HOST=192.168.5.53
# Port of that vhost (webserver_nginx publishes 80)
OMI_PUBLIC_PORT=80
# Clients nginx admits (space-separated CIDRs). Anyone admitted can sign in as
# any user and read /_local/storage, so keep it to networks you trust.
OMI_ALLOWED_CIDRS=192.168.5.0/24
# Optional nginx template settings (defaults shown)
# OMI_BACKEND_UPSTREAM=host.docker.internal:8109   # backend, published on 172.17.0.1
# OMI_AUTH_UPSTREAM=host.docker.internal:8104      # Auth emulator, published on 172.17.0.1
# OMI_MAX_BODY_SIZE=500m                           # offline audio sync uploads
#
# OMI_LOCAL_STORAGE_BASE_URL (backend section above) stays in-stack: pointing
# it at this vhost breaks batch STT, because the backend's own requests reach
# nginx masqueraded as a docker-bridge IP, which the allowlist rejects.
#
# App build (scripts/build_app.sh); defaults derive from OMI_PUBLIC_HOST/PORT
# OMI_APP_API_BASE_URL=http://192.168.5.53/        # trailing slash required
# OMI_APP_AUTH_EMULATOR_HOST=192.168.5.53
# OMI_APP_AUTH_EMULATOR_PORT=80
# OMI_APP_BUILD_MODE=release                       # release | profile | debug
# OMI_APP_TARGET_PLATFORMS=android-arm64           # empty = all ABIs (bigger APK)
